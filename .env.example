# setup.ps1 creates ignored .local/runtime.json for local infrastructure.
# Environment names used by services; local launchers populate them from runtime.json.
# Never commit real credentials:
# DATABASE_URL=postgresql+psycopg://...
# TEST_DATABASE_URL=postgresql+psycopg://.../bring_vene_test
# BACKEND_URL=http://127.0.0.1:8000
# BRING_VENE_MODE=fixture
# BRING_VENE_DEVELOPMENT=false
# COOKIE_SECURE=true
# SESSION_HOURS=8
# FRONTEND_ORIGIN=https://bring-vene.invalid
# The local launcher enables fixture admission and HTTP cookies only on loopback.
# Providers are selected explicitly; missing live credentials never select fixtures.

# Local media credentials are generated under ignored .local/runtime.json.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
# VOICE_PROVIDER=fixture
# For explicit live STT mode only (no automatic fixture fallback):
# DEEPGRAM_API_KEY=...
# DEEPGRAM_MODEL=nova-3

# Explicit model mode; fixture is the original finite scenario interpreter, not an LLM.
# MODEL_PROVIDER=fixture
# For explicit DeepSeek mode: MODEL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=...
# DEEPSEEK_MODEL=deepseek-flash
# OpenAI remains optional: select MODEL_PROVIDER=openai explicitly.
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-6-astra
# MODEL_TIMEOUT_SECONDS=20
# scripts/dev.ps1 -ModelLive uses the configured model with no fixture fallback.

# Public speech is independently configured and needs every participant's agreement.
# TTS_PROVIDER=fixture
# CARTESIA_API_KEY=...
# CARTESIA_VOICE_ID=...
# CARTESIA_MODEL=sonic-3-2026-01-12
# SPEECH_QUIET_SECONDS=0.7
# SPEECH_COOLDOWN_SECONDS=10
# SPEECH_TTL_SECONDS=90
# scripts/dev.ps1 -TtsLive selects Cartesia with no offline fallback.

# Local sandbox callbacks (generated by the owned launcher; not provider accounts):
# OFFICE_URL=http://127.0.0.1:8012
# OFFICE_TOKEN=...
# OFFICE_CALLBACK_URL=http://127.0.0.1:8001/integrations/office/results
# OFFICE_CALLBACK_SECRET=... # at least 32 characters; independent HMAC key
# CONTINUITY_RETENTION_DAYS=7 # operational traces, not document text
# scripts/dev.ps1 -LiveProviders selects actual STT/model/TTS with local fictional invitations.
# All-provider synthetic gate: scripts/check-live.ps1 (explicit providers; no fallback)
